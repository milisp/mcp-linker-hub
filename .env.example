# Generate a unique secret with: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_PATH=./data/hub.sqlite
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional OAuth providers. Register /api/auth/callback/github or /google.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar owns the payment records. Local SQLite caches verified entitlements.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Replace product IDs with real products; priceLabel must match Polar pricing.
POLAR_PRODUCTS=[]
# Example: [{"slug":"hosted-pro","productId":"YOUR_PRODUCT_ID","tier":"PRO","dailyRequestLimit":1000,"name":"Hosted Pro","priceLabel":"$10/month","recurring":true}]

# Only audited, stateless HTTPS MCP services may be configured by the operator.
HOSTED_MCP_SERVICES=[]
# Example: [{"id":"search","name":"Search","url":"https://YOUR_SERVER/mcp","tokenEnv":"SEARCH_MCP_TOKEN","reviewReference":"review-2026-09-30","stateless":true}]
SEARCH_MCP_TOKEN=
