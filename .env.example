# Public URL of the deployed site (sitemap, canonical links, robots.txt).
SITE_URL=https://mcp-linker.milisp.dev

# Local checkout of github.com/milisp/mcp-servers. Leave empty to fetch the
# catalog from GitHub at build time.
MCP_SERVERS_DIR=
# Branch, tag, or commit of the catalog to fetch when MCP_SERVERS_DIR is empty.
MCP_SERVERS_REF=main

# Polar checkout links. Create them in Polar and paste the URLs here.
# Empty values disable the matching buy button.
PUBLIC_POLAR_CHECKOUT_PERSONAL=
PUBLIC_POLAR_CHECKOUT_PRO=

# Show early-bird prices. Set to "false" to show regular prices.
PUBLIC_EARLY_BIRD=true
