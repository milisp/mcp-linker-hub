---
import Base from "../layouts/Base.astro";
---

<Base
  title="Add to MCP Linker"
  description="Open an MCP server configuration in MCP Linker."
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <section id="install" hidden>
      <h1 class="text-3xl font-bold">Add to MCP Linker</h1>
      <p class="mt-3 text-muted">
        <span id="name" class="font-mono font-semibold text-ink"></span> opens in
        MCP Linker's Import Configuration page. Nothing is installed until you
        confirm there.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a id="open" href="#" class="btn-primary">Open in MCP Linker</a>
        <a id="repo" href="#" class="btn-secondary" hidden>View repository</a>
      </div>
      <p class="mt-4 text-sm text-muted">
        No app yet? <a href="/pricing" class="text-brand hover:underline"
          >Get MCP Linker</a
        >.
      </p>
      <h2 class="mt-8 text-lg font-semibold">Configuration</h2>
      <pre
        id="config"
        class="card mt-2 overflow-x-auto p-4 font-mono text-sm"></pre>
      <p id="invalid" class="mt-2 text-sm text-red-600" hidden>
        The configuration in this link is not valid.
      </p>
    </section>

    <section id="badge" hidden>
      <h1 class="text-3xl font-bold">Make a badge</h1>
      <p class="mt-3 text-muted">
        Paste an MCP server JSON. You get an "Add to MCP Linker" badge for your
        README that opens the configuration in the app.
      </p>
      <label for="input" class="mt-6 block text-sm font-medium"
        >MCP server JSON</label
      >
      <textarea
        id="input"
        rows="9"
        spellcheck="false"
        class="card mt-2 w-full p-3 font-mono text-sm"
        placeholder={'{ "mcpServers": { "my-server": { "command": "npx", "args": ["-y", "my-server"] } } }'}
      ></textarea>
      <p id="error" class="mt-2 text-sm text-red-600" role="alert"></p>
      <div id="output" hidden>
        <h2 class="mt-6 text-lg font-semibold">Markdown</h2>
        <pre id="markdown" class="card mt-2 overflow-x-auto p-3 font-mono text-sm"></pre>
        <button type="button" data-copy="markdown" class="btn-secondary mt-2"
          >Copy Markdown</button
        >
        <h2 class="mt-6 text-lg font-semibold">HTML</h2>
        <pre id="html" class="card mt-2 overflow-x-auto p-3 font-mono text-sm"></pre>
        <button type="button" data-copy="html" class="btn-secondary mt-2"
          >Copy HTML</button
        >
      </div>
    </section>
  </div>
</Base>

<script>
  import {
    buildDeepLink,
    buildHtml,
    buildInstallUrl,
    buildMarkdown,
    decodeConfig,
    parseServerInput,
    repoUrl,
  } from "../lib/badge";

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const params = new URLSearchParams(location.search);
  const name = params.get("name");
  const config = params.get("config");
  const repo = params.get("repo");

  if ((name && config) || repo) {
    $("install").hidden = false;
    $("name").textContent = name ?? repo;
    if (name && config) {
      const open = $("open") as HTMLAnchorElement;
      open.href = buildDeepLink(name, config);
      const decoded = decodeConfig(config);
      if (decoded === undefined) {
        $("invalid").hidden = false;
      } else {
        $("config").textContent = JSON.stringify(decoded, null, 2);
      }
    } else {
      $("open").hidden = true;
      $("config").hidden = true;
    }
    const url = repo ? repoUrl(repo) : undefined;
    if (url) {
      const link = $("repo") as HTMLAnchorElement;
      link.href = url;
      link.hidden = false;
    }
  } else {
    $("badge").hidden = false;
    const input = $("input") as HTMLTextAreaElement;
    const update = () => {
      const text = input.value.trim();
      $("output").hidden = true;
      $("error").textContent = "";
      if (!text) return;
      const result = parseServerInput(text);
      if ("error" in result) {
        $("error").textContent = result.error;
        return;
      }
      const installUrl = buildInstallUrl(location.origin, result);
      $("markdown").textContent = buildMarkdown(installUrl);
      $("html").textContent = buildHtml(installUrl);
      $("output").hidden = false;
    };
    input.addEventListener("input", update);
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-copy]",
    )) {
      button.addEventListener("click", async () => {
        const label = button.textContent;
        try {
          await navigator.clipboard.writeText(
            $(button.dataset.copy ?? "").textContent ?? "",
          );
          button.textContent = "Copied";
        } catch {
          button.textContent = "Copy failed";
        }
        setTimeout(() => {
          button.textContent = label;
        }, 1500);
      });
    }
  }
</script>
