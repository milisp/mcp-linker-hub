---
import ServerCard from "../../components/ServerCard.astro";
import Base from "../../layouts/Base.astro";
import { getCatalog } from "../../lib/catalog";
import { REGISTRY_URL } from "../../lib/site";

const { categories, collections, servers } = await getCatalog();
const groups = categories
  .map((category) => ({
    category,
    servers: servers.filter((server) => server.category === category),
  }))
  .filter((group) => group.servers.length);
---

<Base
  title="MCP servers"
  description="Curated MCP servers you can add to Claude Code, Codex, Claude Desktop, Cursor, and more with MCP Linker."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold">MCP servers</h1>
        <p class="mt-2 max-w-2xl text-muted">
          {servers.length} reviewed servers. MCP Linker also browses every server
          in the <a href={REGISTRY_URL} class="text-brand hover:underline"
            >official MCP Registry</a
          >.
        </p>
      </div>
      <a href="/submit" class="btn-secondary self-start sm:self-auto"
        >Submit a server</a
      >
    </div>

    {
      collections.length > 0 && (
        <section class="mt-8" aria-label="Collections">
          <h2 class="text-sm font-medium text-muted">Collections</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {collections.map((collection) => (
              <a
                href={`/collections/${collection.id}`}
                class="rounded-full border border-line px-3 py-1.5 text-sm hover:border-brand"
              >
                {collection.title}
                <span class="text-muted"> · {collection.servers.length}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <label class="mt-8 block">
      <span class="sr-only">Search servers</span>
      <input
        id="server-search"
        type="search"
        placeholder="Search servers"
        autocomplete="off"
        class="w-full rounded-lg border border-line bg-page px-4 py-2.5 outline-none focus:border-brand sm:max-w-sm"
      />
    </label>

    {
      groups.map((group) => (
        <section class="mt-10" data-server-group>
          <h2 class="text-lg font-semibold">{group.category}</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.servers.map((server) => (
              <ServerCard server={server} />
            ))}
          </div>
        </section>
      ))
    }
    <p id="no-results" class="mt-10 hidden text-muted">
      No match here. Try Discover in the app, which also searches the official
      MCP Registry.
    </p>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("#server-search");
  const empty = document.querySelector<HTMLElement>("#no-results");
  input?.addEventListener("input", () => {
    const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const group of document.querySelectorAll<HTMLElement>(
      "[data-server-group]",
    )) {
      let groupShown = 0;
      for (const card of group.querySelectorAll<HTMLElement>(
        "[data-server-card]",
      )) {
        const text = card.dataset.search ?? "";
        const match = terms.every((term) => text.includes(term));
        card.hidden = !match;
        if (match) groupShown++;
      }
      group.hidden = groupShown === 0;
      shown += groupShown;
    }
    empty?.classList.toggle("hidden", shown > 0);
  });
</script>
