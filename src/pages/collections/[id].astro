---
import ServerIcon from "../../components/ServerIcon.astro";
import Base from "../../layouts/Base.astro";
import {
  appDeepLink,
  type CatalogCollection,
  getCatalog,
} from "../../lib/catalog";
import { DOWNLOAD_URL } from "../../lib/site";

export async function getStaticPaths() {
  const { collections } = await getCatalog();
  return collections.map((collection) => ({
    params: { id: collection.id },
    props: { collection },
  }));
}

interface Props {
  collection: CatalogCollection;
}

const { collection } = Astro.props;
---

<Base
  title={`${collection.title} MCP servers`}
  description={collection.description}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <a href="/servers" class="text-sm text-muted hover:text-ink">← All servers</a>
    <p class="mt-6 text-sm font-medium text-brand">Collection</p>
    <h1 class="mt-1 text-3xl font-bold">{collection.title}</h1>
    <p class="mt-3 max-w-2xl text-muted">{collection.description}</p>

    <ol class="mt-10 space-y-3">
      {
        collection.servers.map((server) => (
          <li class="card flex flex-col gap-4 p-4 sm:flex-row sm:items-center">
            <a
              href={`/servers/${server.id}`}
              class="flex min-w-0 flex-1 items-center gap-3"
            >
              <ServerIcon server={server} />
              <span class="min-w-0">
                <span class="block font-medium capitalize hover:underline">
                  {server.title}
                </span>
                <span class="mt-0.5 line-clamp-2 block text-sm text-muted">
                  {server.description}
                </span>
              </span>
            </a>
            <a
              href={appDeepLink(server)}
              class="btn-secondary shrink-0 self-start sm:self-auto"
              >Open in MCP Linker</a
            >
          </li>
        ))
      }
    </ol>

    <p class="mt-8 text-sm text-muted">
      Add each server from its page, or open it in <a
        href={DOWNLOAD_URL}
        class="text-brand hover:underline">MCP Linker</a
      >, where you choose the client and scope.
    </p>
  </div>
</Base>
