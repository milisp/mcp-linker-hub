---
import "../styles/global.css";
import { CATALOG_REPO_URL } from "../lib/catalog";
import {
  CONTACT_EMAIL,
  DOWNLOAD_URL,
  GITHUB_URL,
  SITE_NAME,
} from "../lib/site";
import { formatStars, getStarCount } from "../lib/stars";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Add MCP servers to Claude Code, Codex, Claude Desktop, Cursor, and more, without editing config files.",
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/mcp-linker-home.png", Astro.site);
const nav = [
  { href: "/servers", label: "Servers" },
  { href: "/pricing", label: "Pricing" },
];
const stars = await getStarCount();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-page focus:p-2"
      >Skip to content</a
    >
    <header class="border-b border-line">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
      >
        <a href="/" class="flex items-center gap-2 font-semibold">
          <img src="/icon.png" alt="" width="28" height="28" class="rounded-md" />
          {SITE_NAME}
        </a>
        <nav class="flex items-center gap-1 text-sm sm:gap-4">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="rounded px-2 py-1 text-muted hover:text-ink"
                aria-current={
                  Astro.url.pathname.startsWith(item.href) ? "page" : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={GITHUB_URL}
            data-github-stars
            data-repo={new URL(GITHUB_URL).pathname.slice(1)}
            class="flex items-center gap-1.5 rounded px-2 py-1 text-muted hover:text-ink"
            aria-label={`Star on GitHub${stars === null ? "" : ` (${stars} stars)`}`}
          >
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            <span
              data-stars-badge
              class:list={[
                "items-center gap-1 sm:inline-flex",
                stars === null ? "hidden sm:hidden" : "hidden",
              ]}
            >
              <span data-stars-count>{stars !== null && formatStars(stars)}</span>
            </span>
          </a>
          <a href={DOWNLOAD_URL} class="btn-primary hidden sm:inline-flex"
            >Download</a
          >
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line text-sm text-muted">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} {SITE_NAME}. Source under AGPL-3.0.</p>
        <nav class="flex flex-wrap gap-4">
          <a href="/submit" class="hover:text-ink">Submit a server</a>
          <a href={CATALOG_REPO_URL} class="hover:text-ink">Catalog</a>
          <a href="/privacy" class="hover:text-ink">Privacy</a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-ink">Contact</a>
        </nav>
      </div>
    </footer>
    <script>
      import { formatStars } from "../lib/stars-format";

      const link = document.querySelector<HTMLElement>("[data-github-stars]");
      const badge = link?.querySelector<HTMLElement>("[data-stars-badge]");
      const count = link?.querySelector<HTMLElement>("[data-stars-count]");
      if (link && badge && count) {
        fetch(`https://api.github.com/repos/${link.dataset.repo}`)
          .then((res) => (res.ok ? res.json() : null))
          .then((data) => {
            if (typeof data?.stargazers_count !== "number") return;
            count.textContent = formatStars(data.stargazers_count);
            badge.classList.remove("hidden", "sm:hidden");
            badge.classList.add("hidden", "sm:inline-flex");
            link.setAttribute(
              "aria-label",
              `Star on GitHub (${data.stargazers_count} stars)`,
            );
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
